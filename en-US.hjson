Mods: {
	GemSwords: {
		Items: {
			AmethystBlade: {
				DisplayName: Amethyst Blade
				Tooltip: Every second swing shoots out a flame burst
			}

			TopazBlade: {
				DisplayName: Topaz Blade
				Tooltip: Envelopes hit enemies in a toxic gas cloud
			}

			EmeraldSword: {
				DisplayName: Emerald Longsword
				Tooltip:
					'''
					Gives Dryad's Blessing when held
					Spawns a tracker on a hit enemy. Only 1 tracker may exist at a time
					Right click to make them explode into a burst of thorns
					'''
			}

			SapphireSword: {
				DisplayName: Sapphire Longsword
				Tooltip:
					'''
					Inflicts frostburn on hit
					Every 3rd strike drops an icicle on top of hit enemy
					'''
			}

			RubySword: {
				DisplayName: Ruby Greatsword
				Tooltip:
					'''
					Hitting an enemy powers up the sword (up to twice)
					When powered up the sword deals increased damage
					Right clicking when powered up will release a ruby slash and grant a short burst of rapid regenration
					'''
			}

			DiamondSword: {
				DisplayName: Diamond Greatsword
				Tooltip:
					'''
					Grants light when held
					Every hit makes the sword grow a shard (up to 3)
					Right click launches the shards into the air and homes in on the closest target
					'''
			}

			GreaterAmethystBlade: {
				DisplayName: Greater Amethyst Blade
				Tooltip:
					'''
					Shoots fireballs when swung
					Right click to enter flame mode
					When flame mode is active damage, swing speed and size are increased
					Consumes fuel while flame mode is active
					Fuel slowly recharges passively
					'''
			}

			AmethystJewel: {
				DisplayName: Amethyst Jewel
				Tooltip: A jewel imbued with dark and light souls. Can be used to improve a blade
			}
		}

		Projectiles: {
			DiamondSwordProj.DisplayName: Diamond Sword Projectile
			Tracker.DisplayName: Tracker
			GreaterAmethystBladeProj.DisplayName: Greater Amethyst Blade Projectile
			RubySwordProj.DisplayName: Ruby Sword Projectile
			DiaShards.DisplayName: Diamond Shard
			FireBall.DisplayName: Fire Ball
			FireSpark.DisplayName: Fire Spark
			RubyWave.DisplayName: Ruby Wave
			SapphireProj.DisplayName: Sapphire Projectile
			DMDProj.DisplayName: D M D Proj
		}
	}
}
